# ─── website (Next.js on Vercel) ───────────────────────────────────────────
NEXT_PUBLIC_WS_URL=wss://floor.founderfloor.net/ws
# NEXT_PUBLIC_STRIPE_LINK_PRO_MONTHLY= …see docs/DEPLOY.md

# ─── floor server (server/index.mjs on the VPS) ────────────────────────────
# PORT_WS=3001
# FF_DATA_FILE=/home/founderfloor/app/server/floor-data.json
# ADMIN_EMAILS=ak@founderfloor.net,ak@founder-floor.com
# FOUNDING_SEATS=25
# STAND_TTL_MS=604800000
# RESEND_API_KEY=
# STRIPE_WEBHOOK_SECRET=
# PH_PROMO_CODE=PRODUCTHUNT  PH_PROMO_DAYS=90  PH_PROMO_TICKETS=0  PH_PROMO_MAX=2000
# SUPABASE_JWT_SECRET=          # lets the floor server mint app JWTs (docs/reboot-auth.md)

# ─── app (apps/mobile) — EXPO_PUBLIC_* ships in the bundle; never put a secret here ──
EXPO_PUBLIC_FLOOR_URL=https://floor.founderfloor.net
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# ─── Supabase Edge Functions (supabase secrets set …) ──────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_CAREFUL=claude-sonnet-5
